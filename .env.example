# ── Gemini ────────────────────────────────────────────────────────────────
# Used by the /api/gemini serverless function (never exposed to the browser)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── remove.bg ─────────────────────────────────────────────────────────────
# Used by the /api/removebg serverless function (never exposed to the browser)
# Get from: https://www.remove.bg/api
REMOVEBG_API_KEY=

# ── Firebase (optional) ───────────────────────────────────────────────────
# Public web API key used server-side to verify Firebase ID tokens.
# Falls back to the key in firebase-config.js when unset.
FIREBASE_WEB_API_KEY=

# Note: browser-side Firebase config lives in firebase-config.js
# (copy firebase-config.example.js), not in env vars.
